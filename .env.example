# Laks AI Agent - Environment Configuration
# Copy this file to .env and update with your values

# Application Settings
APP_NAME="Laks AI Agent"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8123

# Database Configuration
# Options: sqlite, mysql, pgsql
DB_CONNECTION=sqlite
DB_DATABASE=storage/database.sqlite

# MySQL Configuration (if DB_CONNECTION=mysql)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=Laks_ai
# DB_USERNAME=Laks_ai_user
# DB_PASSWORD=secure_password

# PostgreSQL Configuration (if DB_CONNECTION=pgsql)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=Laks_ai
# DB_USERNAME=Laks_ai_user
# DB_PASSWORD=secure_password

# GitHub OAuth Configuration
# Get your credentials at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session Configuration
SESSION_LIFETIME=120
SESSION_COOKIE_NAME=indonesia_ai_session
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# Security
# Generate a random 32-character string for APP_KEY
APP_KEY=
ALLOWED_ORIGINS=http://localhost:8123,https://indonesiasatu.com

# AI Configuration
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# Cache Configuration (Redis)
CACHE_DRIVER=file
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DATABASE=0

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAYS=14

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW=60

# CORS Settings
CORS_ENABLED=true
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# Timezone
APP_TIMEZONE=Asia/Jakarta

# Locale
APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Geocoding (for location features)
GEOCODING_ENABLED=true
GEOCODING_PROVIDER=nominatim

# Email Configuration (for notifications)
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@indonesiasatu.com
# MAIL_FROM_NAME="${APP_NAME}"

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt

# Performance
CACHE_ENABLED=true
CACHE_TTL=3600
MINIFY_HTML=true
MINIFY_CSS=true
MINIFY_JS=true

# Development Settings (only for APP_ENV=development)
# QUERY_LOG=true
# PROFILER_ENABLED=true
